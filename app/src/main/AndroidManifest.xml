<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required for all HTTP/HTTPS network calls via Retrofit. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".BGrowthApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BGroth"
        android:usesCleartextTraffic="true">
        <!--
            usesCleartextTraffic = true allows plain HTTP traffic to the local
            Laravel development server (http://YOUR_IP:8000).
            The local dev server does not run TLS, so this flag is required.
            REMOVE or set to false when the production server uses HTTPS.
        -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BGroth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
